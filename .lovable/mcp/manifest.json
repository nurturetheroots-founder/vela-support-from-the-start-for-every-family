{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://enhqroqlgayefzdfnhep.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "vela-app",
      "version": "0.1.0",
      "title": "Vela; Support from the Start for Every Family"
    },
    "tools": [
      {
        "name": "get_profile",
        "title": "Get parent profile",
        "description": "Read the signed-in parent's Vela profile: name, stage, due or birth date, and current focus areas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_checkins",
        "title": "List daily check-ins",
        "description": "List the signed-in parent's recent daily check-ins (mood, sleep, feeding, notes), newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many check-ins to return. Defaults to 14.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "log_checkin",
        "title": "Log a daily check-in",
        "description": "Save a daily check-in for the signed-in parent: mood (1-5), sleep quality, feeding status, and an optional note.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "mood_score": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Mood from 1 (heavy) to 5 (light)."
            },
            "sleep_quality": {
              "description": "Short sleep description, e.g. 'broken', 'ok', 'rested'.",
              "type": "string"
            },
            "feeding_status": {
              "description": "Short feeding description, e.g. 'smooth', 'tough'.",
              "type": "string"
            },
            "note": {
              "description": "Anything the parent wants to remember about today.",
              "type": "string"
            },
            "logged_date": {
              "description": "Date in YYYY-MM-DD. Defaults to today.",
              "type": "string"
            }
          },
          "required": [
            "mood_score"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_screenings",
        "title": "List EPDS screenings",
        "description": "List the signed-in family's completed EPDS screenings with total score, date, and what prompted each one.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_alerts",
        "title": "List support notices",
        "description": "List the signed-in family's support notices (escalations) — what triggered each one and whether it's still open.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_education",
        "title": "List education modules",
        "description": "Browse Vela's fourth-trimester learning library. Optionally filter by week number or a keyword.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "week": {
              "description": "Only return modules for this postpartum week.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "query": {
              "description": "Keyword to match against title, tags, and excerpt.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
